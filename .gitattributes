* text=auto
*.cs text eol=lf
*.shader text eol=lf
*.py text eol=lf
*.json text eol=lf
*.meta text eol=lf
*.md text eol=lf
*.png binary
*.jpg binary
*.fbx binary
*.dll binary
*.dylib binary
*.eucar binary
# These pinned inputs retain exact bytes across platforms, including original
# upstream line endings. Their hashes identify source/geometry and provenance.
/World/Source/** -text
/Unity/Assets/ThirdParty/** -text
/Provenance/** -text
/LICENSES/** -text

*.euradio binary
*.euworld binary

# Audio inputs and frozen vehicle payloads retain reviewed bytes.
*.mp3 binary
*.wav binary
/ContentSources/VW-Splittie/LICENSE.txt -text
/ContentSources/VW-Splittie/README.txt -text
