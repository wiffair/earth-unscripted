{
  "name": "earth-unscripted-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1",
    "build": "node tools/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "types": "wrangler types --include-runtime false",
    "verify": "npm run build && node tools/check-site.mjs && npm run check && npm test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261116.1",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "wrangler": "4.163.0"
  },
  "engines": {
    "node": ">=22"
  }
}
